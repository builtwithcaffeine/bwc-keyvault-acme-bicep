        "replyUrls": "[parameters('replyUrls')]",
        "samlSingleSignOnSettings": "[if(not(empty(parameters('samlSingleSignOnSettings'))), parameters('samlSingleSignOnSettings'), null())]",
        "servicePrincipalType": "[parameters('servicePrincipalType')]",
        "tags": "[parameters('tags')]",
        "tokenEncryptionKeyId": "[if(not(empty(parameters('tokenEncryptionKeyId'))), parameters('tokenEncryptionKeyId'), null())]"
      },
      "metadata": {
        "description": "Microsoft Graph Service Principal"
      }
    }
  },
  "outputs": {
