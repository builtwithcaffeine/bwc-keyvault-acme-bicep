{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "10349703078491022068"
    }
  },
  "parameters": {
    "functionAppName": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Name of the existing Acmebot Function App to update."
      }
    },
    "acmebotReleaseTag": {
      "type": "string",
      "defaultValue": "latest",
      "minLength": 1,
      "metadata": {
        "description": "Acmebot release tag to deploy. Use latest, 5.0.0, or v5.0.0."
      }
    }
  },
  "variables": {
    "normalizedReleaseTag": "[if(startsWith(toLower(parameters('acmebotReleaseTag')), 'v'), parameters('acmebotReleaseTag'), format('v{0}', parameters('acmebotReleaseTag')))]",
    "releaseTag": "[if(equals(toLower(parameters('acmebotReleaseTag')), 'latest'), 'latest', variables('normalizedReleaseTag'))]",
    "appPackageUri": "[format('https://github.com/polymind-inc/acmebot/releases/{0}/download/acmebot.zip', variables('releaseTag'))]"
  },
  "resources": {
    "deployFunctionAppPackage": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('deployFunctionAppPackage-{0}', uniqueString('deployFunctionAppPackage', deployment().name))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "functionAppName": {
            "value": "[parameters('functionAppName')]"
          },
          "packageUri": {
            "value": "[variables('appPackageUri')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "17235472924108284717"
            },
            "name": "Site Extension OneDeploy",
            "description": "This module deploys the OneDeploy site extension package to an existing function app."
          },
          "parameters": {
            "functionAppName": {
              "type": "string",
              "metadata": {
                "description": "Required. The name of the parent site resource."
              }
            },
            "extensionName": {
              "type": "string",
              "defaultValue": "onedeploy",
              "allowedValues": [
                "onedeploy"
              ],
              "metadata": {
                "description": "Optional. The name of the extension."
              }
            },
            "packageUri": {
              "type": "string",
              "metadata": {
                "description": "Required. The ZIP package URI for the release artifact."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Web/sites/extensions",
              "apiVersion": "2025-03-01",
              "name": "[format('{0}/{1}', parameters('functionAppName'), parameters('extensionName'))]",
              "properties": {
                "packageUri": "[parameters('packageUri')]",
                "remoteBuild": false,
                "type": "zip"
              }
            }
          ],
          "outputs": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "The name of the extension."
              },
              "value": "[parameters('extensionName')]"
            },
            "resourceId": {
              "type": "string",
              "metadata": {
                "description": "The resource ID of the extension."
              },
              "value": "[resourceId('Microsoft.Web/sites/extensions', parameters('functionAppName'), parameters('extensionName'))]"
            },
            "resourceGroupName": {
              "type": "string",
              "metadata": {
                "description": "The resource group the extension was deployed into."
              },
              "value": "[resourceGroup().name]"
            }
          }
        }
      }
    }
  },
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[parameters('functionAppName')]"
    },
    "acmebotReleaseTag": {
      "type": "string",
      "value": "[parameters('acmebotReleaseTag')]"
    },
    "releaseTag": {
      "type": "string",
      "value": "[variables('releaseTag')]"
    },
    "appPackageUri": {
      "type": "string",
      "value": "[variables('appPackageUri')]"
    },
    "extensionName": {
      "type": "string",
      "value": "[reference('deployFunctionAppPackage').outputs.name.value]"
    },
    "extensionResourceId": {
      "type": "string",
      "value": "[reference('deployFunctionAppPackage').outputs.resourceId.value]"
    }
  }
}